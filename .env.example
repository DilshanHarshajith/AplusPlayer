# Copy to `.env` (or set in your environment / docker-compose) and fill in.
# The app reads these at startup; real environment variables win over the file.

# REQUIRED in production. Signs user session cookies. Generate one:
#   openssl rand -hex 32
FLASK_SECRET_KEY=

# Where the shared SQLite state lives (defaults to ./aplus_state.db).
APLUS_STATE_DB=/data/aplus_state.db

# Optional gunicorn tuning.
#GUNICORN_WORKERS=2
#GUNICORN_THREADS=8
#GUNICORN_TIMEOUT=600
