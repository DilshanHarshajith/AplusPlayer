# Copy to `.env` (or set in your environment / docker-compose) and fill in.
# The app reads these at startup; real environment variables win over the file.

# REQUIRED in production. Signs user session cookies. Generate one:
#   openssl rand -hex 32
FLASK_SECRET_KEY=

# Where the shared SQLite state lives (defaults to ./aplus_state.db).
APLUS_STATE_DB=/data/aplus_state.db

# Container UID/GID to run as. This MUST match your host user's UID/GID so that
# SQLite database files (and WAL/SHM sidecars) created on the mounted ./data
# volume are readable/writable by both the container and the host.
# Defaults (1000:1000) match the first non-root user on most Linux systems.
# Run `id -u` and `id -g` to find your values, then uncomment and set:
# APLUS_UID=1000
# APLUS_GID=1000

# Optional gunicorn tuning.
#GUNICORN_WORKERS=2
#GUNICORN_THREADS=8
#GUNICORN_TIMEOUT=600
